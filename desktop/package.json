{
  "name": "imgmark-desktop",
  "productName": "ImgMark",
  "version": "0.7.4",
  "description": "ImgMark 批量图片水印 桌面壳（Windows / macOS）",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "cn.techysy.imgmark",
    "productName": "ImgMark",
    "directories": {
      "output": "dist",
      "buildResources": "."
    },
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "icon.png",
      "tray-icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "icon.png",
      "identity": null,
      "category": "public.app-category.graphics-design",
      "artifactName": "ImgMark-mac-${arch}-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ImgMark-Setup-${version}.${ext}",
      "shortcutName": "ImgMark"
    },
    "portable": {
      "artifactName": "ImgMark-Portable-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "server",
        "to": "imgmark/server"
      }
    ]
  },
  "allowScripts": {
    "electron@37.10.3": true
  }
}
